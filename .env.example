# Gemini API key used by the server-side botanical analysis routes.
GEMINI_API_KEY=""

# Public app URL used for OAuth callbacks and generated links.
APP_URL=""

# Verde Roatan's approved Supabase project.
SUPABASE_URL="https://moaqgqbqfeckeabigfha.supabase.co"

# Public client key (safe for browser use). Never put a service-role key in VITE_* variables.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# PostgreSQL connection string. Keep the database password private.
# Obtain it from Supabase > Project Settings > Database > Connection string.
# The migration script checks that this URL belongs to the approved project above.
DATABASE_URL=""

# Required safety confirmation for the database migration utility.
CONFIRM_SUPABASE_PROJECT_REF="moaqgqbqfeckeabigfha"

# Set to true only after reviewing the migration and confirming a database backup.
# The migration utility also requires the explicit --apply command-line flag.
ALLOW_SUPABASE_MIGRATION="false"
